{
  "schema_version": "vsight_ccv_experiment_v1",
  "method": "Claim-Conditioned Counterfactual Visual Verifier",
  "actions": ["ACCEPT", "REJECT", "RELOCALIZE"],
  "candidate_set": {
    "members": ["upstream_bbox", "top_k_composite_detector_proposals"],
    "k": 5,
    "k_ablation": [1, 3, 5],
    "duplicate_iou": 0.9
  },
  "train_free_thresholds": {
    "existence_support": 0.25,
    "claim_support": 0.22,
    "atom_support": 0.15,
    "binding_margin": 0.12,
    "alternative_support": 0.3,
    "contradiction_support": 0.7,
    "conjunction": "harmonic",
    "relation_distance_scale": 0.3
  },
  "experiment_matrix": [
    "black_box_train_free",
    "black_box_lightweight_learned",
    "white_box_train_free_mtla",
    "white_box_lightweight_learned_mtla"
  ],
  "main_comparisons": [
    "unchanged_upstream",
    "existing_extratrees_existence_gate",
    "ccv_black_box_train_free",
    "ccv_black_box_learned",
    "mtla",
    "ccv_white_box_train_free",
    "ccv_white_box_learned",
    "conditional_relocalization_router"
  ],
  "ablations": [
    "flat_detector_score",
    "no_counterfactual",
    "no_atom_type",
    "no_reference_geometry",
    "proposal_k_1",
    "proposal_k_3",
    "proposal_k_5",
    "one_view",
    "three_view",
    "composite_single_pass",
    "multi_prompt_2_calls",
    "multi_prompt_5_calls",
    "multi_prompt_10_calls"
  ],
  "inference_budget": {
    "upstream_mllm_calls_per_query": 1,
    "composite_detector_image_encoder_forwards_per_query": 1,
    "proposal_cap": 5,
    "second_mllm_call_allowed": false
  },
  "safety_gates": {
    "max_added_fnr": 0.03,
    "max_positive_miou_loss": 0.005,
    "max_nonzero_to_zero_regression_rate": 0.01,
    "max_roh_minus_boh_gap_delta": 0.0
  },
  "training": {
    "annotation_protocol": "single_project_owner",
    "minimum_reviewers": 1,
    "minimum_confidence": 0.9,
    "exclude": ["UNCERTAIN", "evidence_schema_conflict", "sensitive_attribute"],
    "split_unit": "image_group",
    "holdout": ["one_upstream_model", "one_image_fold"],
    "trainable_components": ["monotonic_action_head", "isotonic_calibrator"]
  },
  "external_evaluation": {
    "prbench_training_allowed": false,
    "prbench_threshold_selection_allowed": false,
    "freeze_before_prbench": true
  }
}
