  "cards": [
    {
      "dot": "cyan",
      "title": "Pairing contract",
      "items": [
        "Each group has exactly ONE immutable positive expression and bbox",
        "The four negatives are counterfactual edits of that same positive target",
        "object / co_occurrence = BOH · attribute / relation = ROH"
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolation, enforced not assumed",
      "items": [
        "500-dev is measurement-only and never trained on",
        "train2000 uses only RefCOCOg train images absent from 500-dev",
        "Disjointness verified on COCO image id, not filename"
      ]
    },
    {
      "dot": "amber",
      "title": "Why the gates exist",
      "items": [
        "Coordinate conventions differ per model; unrescaled [0,1000] boxes score IoU≈0",
        "Qwen3-VL T2 mean IoU 0.055 → 0.198 once rescaled by real image size",
        "UniVG-R1 answered the caption task with boxes: its 0.000 hallucination rate was an artefact"
      ]
    },
    {
      "dot": "violet",
      "title": "Reproducibility",
      "items": [
        "VLM keys read from environment only; no secret in any committed script",
        "Generation is resumable via JSONL state; source files are never overwritten",
        "Repairs are explicit reviewed edits keyed by sample::type, not silent regeneration"
      ]
    }
  ]
}
